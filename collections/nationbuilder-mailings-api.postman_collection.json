  "item": [
    {
      "id": "1e5d164c-e9e2-45e5-b510-fc893c21caf9",
      "name": "Mailings",
      "description": {
        "content": "Referred to as email blasts, mailings send bulk emails to a group of signups at once. Mailings belong to and are sent via a broadcaster. The recipients of a mailing can be selected by lists, filters, or tags. Find more on how to use mailings [here](https://support.nationbuilder.com/en/articles/8077751-create-an-email-blast).",
        "type": "text/plain"
      },
