      "id": "96ed05ce-7b99-40b5-aec8-924521a23fd8",
      "name": "Async Processes",
      "description": {
        "content": "This endpoint is used to get information about deferred or asynchronous processes returned by other endpoints such as adding and removing signups from a list or tagging and untagging signups from a list. Other endpoints in the future may use a deferred model as well.",
        "type": "text/plain"
      },
