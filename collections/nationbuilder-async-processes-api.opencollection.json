{
  "opencollection": "1.0.0",
  "info": {
    "name": "NationBuilder V2 Async Processes API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Async Processes",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Show async process with provided token ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.nationbuilder.com/api/v2/async_processes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "id"
              }
            ]
          },
          "docs": "Returns the async process that matches the given token."
        }
      ]
    }
  ],
  "bundled": true
}